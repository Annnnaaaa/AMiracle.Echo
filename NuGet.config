<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    nuget.org only. This repository uses no private package; the explicit list keeps a private feed configured
    for the whole machine (the suite's GitHub Packages source) out of its restores.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
