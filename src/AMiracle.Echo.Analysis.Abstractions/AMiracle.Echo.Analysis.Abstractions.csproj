<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>AMiracle.Echo.Analysis.Abstractions</PackageId>
    <Description>Pluggable analysis interfaces (IFeedbackAnalyzer, AnalysisContext, AnalysisResult, AnalysisOptions) for AMiracle.Echo. Implement IFeedbackAnalyzer to add transcription, summarization, categorization, or priority scoring. The Echo server picks up registered analyzers automatically.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AMiracle.Echo.Abstractions\AMiracle.Echo.Abstractions.csproj" />
  </ItemGroup>

</Project>
