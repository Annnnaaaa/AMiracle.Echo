<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>AMiracle.Echo.Abstractions</PackageId>
    <Description>Core interfaces (IFeedbackStore, IBlobStore, IFeedbackProcessor) and DTOs for AMiracle.Echo. Implement these to plug in custom storage, blob backends, or pre-persistence processors. Does not depend on EF Core or ASP.NET Core.</Description>
