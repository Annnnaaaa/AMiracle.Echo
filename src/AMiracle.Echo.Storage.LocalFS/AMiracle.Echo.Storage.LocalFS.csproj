<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>AMiracle.Echo.Storage.LocalFS</PackageId>
    <Description>Local-filesystem implementation of AMiracle.Echo's IBlobStore. Writes audio recordings and screenshot attachments to a configurable directory. Best for single-server deployments and development; use the S3 or Azure Blob adapters (v1.1) for distributed storage.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AMiracle.Echo.Abstractions\AMiracle.Echo.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="9.0.0" />
  </ItemGroup>

</Project>
