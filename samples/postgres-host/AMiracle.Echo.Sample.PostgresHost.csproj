<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Sample only; never published. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      In your own project you would reference the NuGet packages:
        <PackageReference Include="AMiracle.Echo.Server" Version="0.1.0" />
        <PackageReference Include="AMiracle.Echo.Storage.EFCore" Version="0.1.0" />
        <PackageReference Include="AMiracle.Echo.Storage.LocalFS" Version="0.1.0" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.0" />
      For this in-repo sample we use ProjectReferences so it builds without published packages.
    -->
    <ProjectReference Include="..\..\src\AMiracle.Echo.Server\AMiracle.Echo.Server.csproj" />
    <ProjectReference Include="..\..\src\AMiracle.Echo.Storage.EFCore\AMiracle.Echo.Storage.EFCore.csproj" />
    <ProjectReference Include="..\..\src\AMiracle.Echo.Storage.LocalFS\AMiracle.Echo.Storage.LocalFS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.0" />
  </ItemGroup>

</Project>
